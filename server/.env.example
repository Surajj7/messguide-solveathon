# PostgreSQL connection (local or Docker)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mess_menu?schema=public"

PORT=4000
JWT_SECRET="change-me-in-production-min-32-chars-long"
JWT_EXPIRES="7d"

# Optional: Groq Cloud API (AI chat, meal hints, monthly PDF summary)
# https://console.groq.com/keys — optional GROQ_MODEL e.g. llama-3.1-8b-instant
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Complaints for same item+day before escalation + admin notification
COMPLAINT_ESCALATION_THRESHOLD=3
